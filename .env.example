# Copy this file to .env and fill values. NEVER commit .env
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI provider: gemini | openai | anthropic | fallback
# "fallback" (or empty key) = rule-based analysis, no API needed
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: override the default model for the provider
AI_MODEL=
AI_TIMEOUT_SECONDS=20
# Example: AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...   (or gemini / openai with their keys)
